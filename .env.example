# Example environment configuration for Cornwall waste collection
UPRN=100040118005
#POSTCODE=
#HOUSE_NUMBER_OR_NAME=

# Optional: set to "false" to disable individual collection types
#INCLUDE_FOOD=true
#INCLUDE_RECYCLING=true
#INCLUDE_RUBBISH=true
#INCLUDE_GARDEN=true
#ENABLE_COLLECTIONS=Food,Recycling
#DISABLE_COLLECTIONS=Garden Waste Collection

# Optional runtime behavior
#STRICT_POSTCODE_MATCH=true
#FAIL_ON_EMPTY=false
#OUTPUT_FILENAME=cornwall_collection.ics
#TITLE=Cornwall Council
#DESCRIPTION=Source for cornwall.gov.uk services for Cornwall Council
#URL=https://cornwall.gov.uk
#USER_AGENT=Cornwall-Waste-Calendar-Generator/1.0
#LOG_LEVEL=INFO

# Optional request tuning
#REQUEST_TIMEOUT=10
#REQUEST_MAX_RETRIES=2
#REQUEST_RETRY_BACKOFF=1.0
